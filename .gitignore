# ignore list from https://github.com/github/gitignore/blob/main/Elixir.gitignore
/_build
/cover
/deps
/doc
/.fetch
erl_crash.dump
*.ez
*.beam
/config/*.secret.exs
.elixir_ls/

# Ignore package tarball (built via "mix hex.build").
ash_storage_xberg-*.tar

# Temporary files, for example, from tests.
/tmp/

# IDE & agent stuff
.vscode
.idea
.DS_Store
.omo/
/.codex/
/.claude/settings.local.json

# caches
/.xberg

# devcontainer CLI is installed via package.json
/node_modules
/xberg
